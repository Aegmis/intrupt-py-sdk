# intrupt-py-sdk — example environment
#
# Copy to .env and fill in your values. The SDK reads process env; the example
# agents load this file via python-dotenv (`load_dotenv()`). In your own agent,
# either call load_dotenv() yourself or export these in the shell.

# ── Approvals (core) ─────────────────────────────────────────────────────────
# Base URL of the intrupt approval API.
AEGMIS_BASE_URL=https://api.aegmis.com

# Org API key (dashboard → Account → API Keys). Format: sk_org_{org_id}_{hash}
# — your org is derived from this key, no separate org id needed.
AEGMIS_API_KEY=sk_org_xxxx_yyyy

# Master switch (default: true). Set false to auto-approve in-process with no
# backend call — handy for local dev and tests.
#AEGMIS_APPROVAL=true

# ── Resume callback (agent server) ───────────────────────────────────────────
# Public URL of your agent server; its /resume endpoint receives decisions.
AGENT_PUBLIC_URL=http://localhost:8081

# Random secret echoed back as X-Agent-Secret on /resume callbacks. Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AGENT_RESUME_SECRET=

# ── Observability (optional) ─────────────────────────────────────────────────
# Aegmis Observability endpoint. Pass it to observability.init() at startup;
# unset → observability is off.
#AEGMIS_OTLP_ENDPOINT=https://obs.aegmis.com

# Kill switch for observability emission (default: true).
#AEGMIS_ENABLE_TRACING=true
